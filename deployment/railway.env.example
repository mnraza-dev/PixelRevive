# Paste into Railway service variables, NOT into the mobile app's environment.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
BACKEND_PROVIDER=local
DATA_DIR=/data
NUMBA_CACHE_DIR=/data/numba
# Generate once locally: openssl rand -hex 32. Keep the same value across deploys.
QUOTA_SECRET=
DAILY_FREE_LIMIT=3
GLOBAL_DAILY_LIMIT=20
MAX_CONCURRENT_JOBS=1
MAX_INPUT_PIXELS=4000000
MAX_OUTPUT_PIXELS=16000000
RESULT_TTL_HOURS=6
ALLOWED_ORIGINS=
TRUST_RAILWAY_PROXY=true
# Initialize volume permissions as root; the entrypoint drops to studio before starting Bun.
RAILWAY_RUN_UID=0
