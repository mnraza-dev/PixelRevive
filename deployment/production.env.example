API_DOMAIN=api.your-domain.com
# Generate once: openssl rand -hex 32. Never rotate routinely; never expose in the app.
QUOTA_SECRET=
BACKEND_PROVIDER=local
DAILY_FREE_LIMIT=3
GLOBAL_DAILY_LIMIT=100
MAX_CONCURRENT_JOBS=2
# Exact HTTPS web origin, only if shipping the web app. Native requests have no Origin.
ALLOWED_ORIGINS=
# Server-only, for BACKEND_PROVIDER=replicate. Set provider spending limits separately.
REPLICATE_API_TOKEN=

# Required full version hashes when using Replicate in production:
REPLICATE_VERSION_AUTO=
REPLICATE_VERSION_FACE_ENHANCE=
REPLICATE_VERSION_PHOTO_RESTORE=
REPLICATE_VERSION_HD_UPSCALE=
REPLICATE_VERSION_SHARPEN=
REPLICATE_VERSION_REMOVE_BG=
