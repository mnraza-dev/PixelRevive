# Mobile/web app. Use your computer's LAN IP for a physical phone.
EXPO_PUBLIC_AI_PROVIDER=backend
EXPO_PUBLIC_BACKEND_PROXY_URL=http://localhost:3001

# Backend settings (loaded by Bun from the root .env)
PORT=3001
BACKEND_PROVIDER=local
DAILY_FREE_LIMIT=3
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional neural restoration/upscaling (paid inference):
# BACKEND_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_your_server_only_token
# Optional version pins, e.g. REPLICATE_VERSION_HD_UPSCALE=<full version hash>
# PYTHON_BIN=/absolute/path/to/python
# Explicit sample-image demo only: EXPO_PUBLIC_AI_PROVIDER=mock

# Must match BACKEND_PROVIDER, for upload consent and provider validation.
EXPO_PUBLIC_PROCESSING_PROVIDER=local
# Required for production app builds (real public URLs, never placeholders):
# EXPO_PUBLIC_PRIVACY_URL=https://your-domain/privacy
# EXPO_PUBLIC_SUPPORT_URL=https://your-domain/support
# APP_ENV=production

# Production server: persist this secret and the DATA_DIR volume across restarts.
# NODE_ENV=production
# QUOTA_SECRET=<generate with: openssl rand -hex 32>
# DATA_DIR=/data
GLOBAL_DAILY_LIMIT=100
MAX_CONCURRENT_JOBS=2
RESULT_TTL_HOURS=24
# Only set for a proxy you control that overwrites/appends X-Forwarded-For:
# TRUSTED_PROXY_IPS=172.30.0.2

# Optional Railway-only ingress trust. Never enable on a direct public server.
# TRUST_RAILWAY_PROXY=true
# Smaller MVP processing limits; defaults remain 20M input / 40M output pixels:
# MAX_INPUT_PIXELS=4000000
# MAX_OUTPUT_PIXELS=16000000
